# NOTE: This file is generated from pyproject.toml.in by CMake.
# Do not edit this file directly. Edit pyproject.toml.in instead.

[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = "isaacteleop"
version = "@ISAAC_TELEOP_PYPROJECT_VERSION@"
description = "Compatibility redirect: the isaacteleop package was renamed to isaaccapture"
readme = "README.md"
requires-python = ">=3.11"
license = "Apache-2.0"
authors = [
    {name = "NVIDIA"}
]
# Exact, not >=. This distribution exists to preserve the meaning of the old
# name's version selector; with >=, `pip install isaacteleop==1.6.2` could
# resolve to isaaccapture 1.9.0, which is code the user did not ask for.
dependencies = ["isaaccapture==@ISAAC_TELEOP_PYPROJECT_VERSION@"]

# Generated by src/compat/CMakeLists.txt from the same requirements-*.txt glob
# the real distribution uses, so an eighth extra cannot be missed here: pip
# treats an undeclared extra as a warning, and a miss installs silently without
# the dependencies the caller asked for.
[project.optional-dependencies]
@ISAAC_TELEOP_COMPAT_EXTRAS@
[tool.setuptools]
include-package-data = false

[tool.setuptools.packages.find]
where = ["."]
namespaces = false
include = ["isaacteleop"]

[tool.setuptools.package-data]
isaacteleop = ["*.pyi", "py.typed"]
