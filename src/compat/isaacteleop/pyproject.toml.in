# NOTE: This file is generated from pyproject.toml.in by CMake.
# Do not edit this file directly. Edit pyproject.toml.in instead.

[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = "isaacteleop"
version = "@ISAAC_TELEOP_PYPROJECT_VERSION@"
description = "Compatibility redirect: the isaacteleop package was renamed to isaaccapture"
readme = "README.md"
requires-python = ">=3.11"
license = "Apache-2.0"
authors = [
    {name = "NVIDIA"}
]
# Exact, not >=: with >=, `isaacteleop==1.6.2` could resolve to isaaccapture 1.9.0.
dependencies = ["isaaccapture==@ISAAC_TELEOP_PYPROJECT_VERSION@"]

# Mirrors src/core/python/pyproject.toml.in; guarded by test_the_alias_wheel_mirrors_every_extra.
[project.optional-dependencies]
dev = ["isaaccapture[dev]==@ISAAC_TELEOP_PYPROJECT_VERSION@"]
ui = ["isaaccapture[ui]==@ISAAC_TELEOP_PYPROJECT_VERSION@"]
retargeters = ["isaaccapture[retargeters]==@ISAAC_TELEOP_PYPROJECT_VERSION@"]
retargeters-lite = ["isaaccapture[retargeters-lite]==@ISAAC_TELEOP_PYPROJECT_VERSION@"]
grounding = ["isaaccapture[grounding]==@ISAAC_TELEOP_PYPROJECT_VERSION@"]
wuji = ["isaaccapture[wuji]==@ISAAC_TELEOP_PYPROJECT_VERSION@"]
cloudxr = ["isaaccapture[cloudxr]==@ISAAC_TELEOP_PYPROJECT_VERSION@"]

[tool.setuptools]
include-package-data = false

[tool.setuptools.packages.find]
where = ["."]
namespaces = false
include = ["isaacteleop"]

[tool.setuptools.package-data]
isaacteleop = ["*.pyi", "py.typed"]
