include "timestamp.fbs";

namespace core;

enum KeyAction : ubyte {
    Release = 0,
    Press = 1,
}

// One key transition reported by a keyboard provider.
struct KeyEvent {
    // Monotonic time (ns) at which the provider reported the transition.
    timestamp_ns: long;

    // Linux evdev key code (see linux/input-event-codes.h, e.g. KEY_W = 17).
    code: ushort;

    action: KeyAction;
}

// Keyboard state for one frame, merged across every attached provider (focused window,
// browser tab, ...). Carries no semantic mapping: which keys mean what (an axis, a
// toggle, a mode switch) is up to the consuming retargeter.
table KeyboardOutput {
    // Evdev key codes held at sample time, in no particular order.
    pressed_keys: [ushort] (id: 0);

    // Every press/release since the previous sample, in the order providers reported
    // them. Autorepeat is never included.
    events: [KeyEvent] (id: 1);
}

// MCAP recording wrapper for KeyboardOutput.
table KeyboardOutputRecord {
    data: KeyboardOutput (id: 0);
    timestamp: DeviceDataTimestamp (id: 1);
}

root_type KeyboardOutputRecord;
