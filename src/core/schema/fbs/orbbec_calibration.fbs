include "timestamp.fbs";

namespace core;

table OrbbecCameraIntrinsics {
  width: uint32 (id: 0);
  height: uint32 (id: 1);
  fx: float (id: 2);
  fy: float (id: 3);
  cx: float (id: 4);
  cy: float (id: 5);
  distortion_model: int32 (id: 6);
  distortion: [float] (id: 7);
}

table OrbbecExtrinsics {
  rotation: [float] (id: 0);
  translation_mm: [float] (id: 1);
}

table OrbbecCalibration {
  device_uid: string (id: 0);
  color_left: OrbbecCameraIntrinsics (id: 1);
  color_right: OrbbecCameraIntrinsics (id: 2);
  left_to_right: OrbbecExtrinsics (id: 3);
  accel_intrinsics: [float] (id: 4);
  gyro_intrinsics: [float] (id: 5);
  accel_to_left: OrbbecExtrinsics (id: 6);
  gyro_to_left: OrbbecExtrinsics (id: 7);
  raw_alignment_yaml: string (id: 8);
  raw_imu_yaml: string (id: 9);
}

table OrbbecCalibrationTracked { data: OrbbecCalibration (id: 0); }

table OrbbecCalibrationRecord {
  data: OrbbecCalibration (id: 0);
  timestamp: DeviceDataTimestamp (id: 1);
}

root_type OrbbecCalibrationRecord;
