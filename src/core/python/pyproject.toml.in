# NOTE: This file is generated from pyproject.toml.in by CMake.
# Do not edit this file directly. Edit pyproject.toml.in instead.
#
# NumPy ABI: We build extensions against NumPy 2.x so a single wheel works with
# both NumPy 1.x and 2.x at runtime.
# See: numpy.org/devdocs/dev/depending_on_numpy.html

[build-system]
requires = ["setuptools>=64", "wheel", "numpy>=2.0"]
build-backend = "setuptools.build_meta"

[project]
name = "isaacteleop"
version = "@ISAAC_TELEOP_PYPROJECT_VERSION@"
description = "Isaac Teleop - Teleoperation with Device I/O"
readme = "README.md"
requires-python = ">=3.11"
license = "Apache-2.0"
authors = [
    {name = "NVIDIA"}
]
dynamic = ["dependencies", "optional-dependencies"]

[tool.setuptools.dynamic]
dependencies = {file = ["requirements.txt"]}
optional-dependencies.dev = {file = ["requirements-dev.txt"]}
optional-dependencies.ui = {file = ["requirements-ui.txt"]}
optional-dependencies.retargeters = {file = ["requirements-retargeters.txt"]}
optional-dependencies.retargeters-lite = {file = ["requirements-retargeters-lite.txt"]}
optional-dependencies.grounding = {file = ["requirements-grounding.txt"]}
optional-dependencies.wuji = {file = ["requirements-wuji.txt"]}
optional-dependencies.cloudxr = {file = ["requirements-cloudxr.txt"]}

[tool.setuptools]
include-package-data = false

# Discover packages from the staged tree instead of listing them by hand: this
# file is generated into python_package/<config>/, whose isaacteleop/ subtree CMake
# has already assembled. A new subpackage then needs no registration here, and
# BUILD_VIZ / BUNDLE_ROBOTIC_GROUNDING select their packages purely by staging
# them or not -- which is why the CMake-substituted viz / robotic_grounding
# package blocks this file used to carry are gone.
#
# namespaces = false is REQUIRED, not a default restated. In pyproject.toml there
# is no separate find-namespace table, and the default finder IS the namespace one
# (setuptools config/expand.py calls find_packages(namespaces=True) ->
# PEP420PackageFinder). Left at the default, any staged directory without an
# __init__.py becomes a package -- notably isaacteleop/cloudxr/native/, the
# vendored CloudXR runtime, whose inclusion would then hinge on package-data glob
# overlap instead of being carried as package data of isaacteleop.cloudxr.
#
# include is scoped to the exact top-level names the old hand-written list carried.
# robotic_grounding comes from the optional V2D drop (BUNDLE_ROBOTIC_GROUNDING);
# naming it explicitly keeps it reachable while an absent drop simply matches
# nothing, and keeps unrelated files that may sit in the staging root (setuptools'
# own build/, *.egg-info) from ever being mistaken for packages.
[tool.setuptools.packages.find]
where = ["."]
namespaces = false
include = ["isaacteleop*", "robotic_grounding", "robotic_grounding.retarget"]

[tool.setuptools.package-data]
isaacteleop = ["*.so", "*.pyd", "*.pyi", "py.typed"]
"isaacteleop.deviceio" = ["*.so", "*.pyd", "*.pyi"]
"isaacteleop.deviceio_trackers" = ["*.so", "*.pyd", "*.pyi"]
"isaacteleop.deviceio_session" = ["*.so", "*.pyd", "*.pyi"]
"isaacteleop.mcap" = ["*.so", "*.pyd", "*.pyi"]
"isaacteleop.oxr" = ["*.so", "*.pyd", "*.pyi"]
"isaacteleop.plugin_manager" = ["*.so", "*.pyd", "*.pyi"]
"isaacteleop.schema" = ["*.so", "*.pyd", "*.pyi"]
"isaacteleop.cloudxr" = ["native/*.so", "native/*.so.*", "native/openxr_cloudxr.json"]
# Matches nothing unless ENABLE_CLOUDXR_EXP_BUNDLE=ON staged the experimental
# runtime; the package's two .py ship either way.
"isaacteleop.cloudxr_exp" = ["native/*.so", "native/*.so.*", "native/openxr_cloudxr.json"]
"isaacteleop.haptic_devices" = ["*.so", "*.pyd", "*.pyi"]
# Keys for packages that are only staged in some configurations are inert
# otherwise -- package-data for a package `find` did not discover matches nothing.
# So these no longer need the CMake-substituted blocks they replace.
"isaacteleop.viz" = ["*.so", "*.pyd", "*.pyi"]
robotic_grounding = ["assets/xmls/sharpawave/*.xml"]

[tool.uv]
# Only use managed Python installations (not system Python)
python-preference = "only-managed"
